<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.michalraczkowski</groupId>
        <artifactId>fakturomost-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fakturomost-desktop</artifactId>
    <name>Fakturomost Desktop</name>

    <dependencies>
        <!-- Our own core module; version comes from the parent's dependencyManagement -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fakturomost-core</artifactId>
        </dependency>

        <!-- Plain Spring Boot starter: DI, config, logging. NOT spring-boot-starter-web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JavaFX (not managed by the Spring BOM, so the version is set explicitly) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito, Spring test support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Version managed in the parent (property archunit.version). -->
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- Separate id so the parent's enforce-build-rules is not merged/overridden. -->
                    <execution>
                        <id>enforce-desktop-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>fakturomost-desktop must not depend on the CLI module or picocli: neither front end depends on the other (addendum §3.4).</message>
                                    <excludes>
                                        <exclude>dev.michalraczkowski:fakturomost-cli</exclude>
                                        <exclude>info.picocli</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>